{
  "name": "hansol-100",
  "version": "1.0.0",
  "description": "All-in-one diagram studio: swimlane process boards (korea100studio engine) + Archify architecture/workflow/sequence/dataflow/lifecycle diagrams, usable as an Agent Skill (Claude Code / Codex) and as a shareable web service with a searchable, editable library.",
  "type": "module",
  "bin": {
    "hansol100": "bin/hansol.mjs",
    "korea100studio": "scripts/board.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "agents/",
    "bin/",
    "engines/",
    "library/",
    "schemas/",
    "scripts/",
    "references/",
    "templates/",
    "fixtures/",
    "docs/architecture.md",
    "docs/service.md",
    "docs/sync-archify.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "serve": "node bin/hansol.mjs serve",
    "doctor": "node bin/hansol.mjs doctor",
    "render": "node bin/hansol.mjs render",
    "audit": "node bin/hansol.mjs audit",
    "sync:archify": "node scripts/sync-archify.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "swimlane",
    "process",
    "workflow",
    "diagram",
    "svg",
    "flowchart",
    "architecture",
    "sequence",
    "dataflow",
    "lifecycle",
    "agent-skill",
    "claude-code",
    "codex",
    "visualization",
    "archify",
    "korea100studio"
  ],
  "author": "evelynn",
  "contributors": [
    "Hosung Seo (korea100studio)",
    "tt-a1i (Archify)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evelynn/Hansol-100.git"
  },
  "homepage": "https://github.com/evelynn/Hansol-100#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "license": "MIT"
}
